# Chave de API do Resend (resend.com), usada pela rota /api/inscricao para
# mandar o e-mail do lead (para contato@priorizecorporativa.com.br) e a
# confirmacao automatica para quem se inscreve. Sem isso, o cadastro falha.
# Nunca prefixar com NEXT_PUBLIC_ — precisa ficar so no servidor.
RESEND_API_KEY=

# App da Web do Apps Script que grava cada inscricao na planilha de inscritos
# (o codigo esta em deploy/planilha-inscricoes.gs). E a fonte de dados que o
# Looker Studio le. Sem essas duas variaveis o site funciona igual: o e-mail
# continua saindo, so nao ha lista acumulada.
# A URL termina em /exec. Nunca prefixar com NEXT_PUBLIC_.
PLANILHA_URL=
PLANILHA_TOKEN=

# Nome da aba de destino. Padrao: Inscricoes (com cedilha e acento: Inscrições).
# So preencher se a aba tiver outro nome.
PLANILHA_ABA=

# Token para autenticar a criacao de links curtos (rota /api/links). Sem
# isso configurado, o endpoint fica fechado — recusa toda requisicao, mesmo
# com token nenhum no header. Gere algo aleatorio, ex.: openssl rand -hex 24.
LINKS_TOKEN=

# URL base usada para montar o link curto na resposta da API (ex.:
# https://encurta.priorizecorporativa.com.br). Se nao preencher, usa a
# origem da propria requisicao — so precisa setar se o subdominio do
# encurtador for diferente do host que recebeu o POST.
LINKS_BASE_URL=
